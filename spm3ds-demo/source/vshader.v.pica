; spm3ds-demo vertex shader: position * (modelView * projection), texcoord and vertex colour passed through.
; Vertex layout (16 bytes): v0 = s16 x,y,z,pad  | v1 = s16 u,v | v2 = u8 r,g,b,a
; The GPU converts integers to float without normalising, so the constants below rescale them:
;   uv     : raw / 128   (GX texcoords have 7 fractional bits)
;   colour : raw / 255
; The position scale (1/64) is folded into the modelView matrix on the CPU.

.fvec projection[4], modelView[4]
.constf consts(0.0078125, 0.00392156862, 1.0, 0.0)
.alias uvscale  consts.xxxx
.alias colscale consts.yyyy
.alias ones     consts.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias incol v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mul outtc0, uvscale,  intex
	mul outclr, colscale, incol
	end
.end
